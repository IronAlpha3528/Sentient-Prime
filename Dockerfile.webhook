FROM python:3.10-slim
WORKDIR /app
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    (pip install --default-timeout=2000 torch --index-url https://download.pytorch.org/whl/cpu || pip install --default-timeout=2000 torch --index-url https://download.pytorch.org/whl/cpu) && \
    (pip install --default-timeout=2000 -r requirements.txt || pip install --default-timeout=2000 -r requirements.txt)
COPY . .
ENV PYTHONPATH=/app/src
EXPOSE 5050
CMD ["uvicorn", "sentinel_prime.simulation.honeypots.webhook_receiver:app", "--host", "0.0.0.0", "--port", "5050"]
